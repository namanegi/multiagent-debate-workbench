            "type": "array"
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "title": "Claims",
            "type": "array"
          },
          "debate_protocol": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DebateProtocolOutcome"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "title": "Evidence",
            "type": "array"
          },
          "failures": {
            "items": {
              "$ref": "#/components/schemas/Failure"
            },
            "title": "Failures",
            "type": "array"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "title": "Messages",
            "type": "array"
          },
          "planning_outcome": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PlanningOutcome"
              },
              {
                "type": "null"
              }
            ]
          },
          "run": {
            "$ref": "#/components/schemas/Run"
          },
          "synthesis": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Synthesis"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "run"
        ],
        "title": "RunSummary",
        "type": "object"
      },
      "Synthesis": {
        "additionalProperties": false,
        "properties": {
          "answer": {
            "maxLength": 5000,
            "minLength": 1,
            "title": "Answer",
            "type": "string"
          },
          "changed_positions": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Changed Positions",
            "type": "array"
          },
          "claim_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Claim Ids",
            "type": "array"
          },
          "completed_responsibilities": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Completed Responsibilities",
            "type": "array"
          },
          "consensus": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Consensus",
            "type": "array"
          },
          "disagreements": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Disagreements",
            "type": "array"
          },
          "evidence_gaps": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Evidence Gaps",
            "type": "array"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Evidence Ids",
            "type": "array"
          },
          "follow_up_checks": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Follow Up Checks",
            "type": "array"
          },
          "generation_method": {
            "$ref": "#/components/schemas/SynthesisGeneration",
            "default": "deterministic"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "is_partial": {
            "default": false,
            "title": "Is Partial",
            "type": "boolean"
          },
          "message_id": {
            "title": "Message Id",
            "type": "string"
          },
          "missing_responsibilities": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Missing Responsibilities",
            "type": "array"
          },
          "stop_reason_code": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RunStopReason"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "message_id",
          "answer"
        ],
        "title": "Synthesis",
        "type": "object"
      },
      "SynthesisGeneration": {
        "enum": [
          "deterministic",
          "provider_success",
          "provider_repaired",
          "deterministic_fallback"
        ],
        "title": "SynthesisGeneration",
        "type": "string"
      },
      "ToolPermission": {
        "enum": [
          "search",
          "fetch"
        ],
        "title": "ToolPermission",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
