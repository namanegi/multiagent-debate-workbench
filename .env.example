# Local application runtime
DEBATE_API_ENVIRONMENT=development
DEBATE_API_DATABASE_URL=sqlite:///./data/debate.db
DEBATE_API_CORS_ORIGINS=["http://localhost:5173"]
VITE_API_BASE_URL=http://localhost:8000

# Runtime provider selection. Keep fake for deterministic, zero-secret local
# runs and CI. OpenAI and Ollama are explicit opt-in live modes.
MODEL_PROVIDER=fake
SEARCH_PROVIDER=fake
FETCH_PROVIDER=fake
# Optional shared Chat Completions reasoning effort: none, low, medium, or high.
# Omit this setting to preserve the provider default.
# MODEL_REASONING_EFFORT=low

# Hosted connection through the shared OpenAI SDK Chat Completions adapter.
# Keep real credentials only in gitignored repo-root .env or .env.local.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_MAX_CONCURRENCY=1
OPENAI_REQUEST_TIMEOUT_SECONDS=30

# Local Qwen3-4B Q4_K_M Hugging Face GGUF served directly by Ollama.
# OLLAMA_API_KEY is a non-secret compatibility placeholder.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=hf.co/Qwen/Qwen3-4B-GGUF:Q4_K_M
OLLAMA_MODEL_REVISION=bc640142c66e1fdd12af0bd68f40445458f3869b
OLLAMA_MAX_CONCURRENCY=1
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

# Live search uses Tavily basic search. Fetching remains local through HTTPX.
# Use SEARCH_PROVIDER=tavily together with FETCH_PROVIDER=safe_httpx for the
# bounded live research path. SafeDocumentFetcher owns the local extractor;
# there is no separate document-extractor selector.
# For an opt-in live search run, copy this file to repo-root .env.local and put
# the key there. Never commit the populated file.
TAVILY_API_KEY=
MAX_SEARCHES_PER_AGENT=2
MAX_VERIFICATION_SEARCHES=1
