        "type": "string"
      },
      "RunStopReason": {
        "enum": [
          "completed",
          "partial",
          "cancelled",
          "failed",
          "event_limit",
          "tool_call_limit",
          "agent_failure",
          "synthesis_failure",
          "orchestration_error",
          "storage_error"
